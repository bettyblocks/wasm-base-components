fetch_wit_deps:
    wkg wit fetch
    cd ./test-component/ && wkg wit fetch

build: fetch_wit_deps
    wash build --skip-fetch

test: fetch_wit_deps
    cargo test --lib --bins

integration-test: fetch_wit_deps
    cargo test --tests '*'

lint: fetch_wit_deps
    cargo check

formatting *args:
    cargo fmt --all {{args}}

clippy:
    cargo clippy --all-targets --all-features -- -D warnings
