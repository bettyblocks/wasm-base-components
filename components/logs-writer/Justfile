
build:
    wash build

test:
    wash wit deps
    cargo test --lib --bins

integration-test:
    wash wit deps
    cd ./test-component/ && wash wit deps
    cargo test --tests '*'

lint:
    wash wit deps
    cd ./test-component/ && wash wit deps
    cargo check

formatting *args:
    cargo fmt --all {{args}}

clippy:
    cargo clippy --all-targets --all-features -- -D warnings
