package betty-blocks-types:upload-file@3.0.0;

// Our platform passes the property as [{ kind: "FILE", name: "<propertyName>" }], we have to accommodate that in the store interfaces.

interface upload-file {
    use betty-blocks-types:data-api/data-api@2.0.0.{helper-context};
    use betty-blocks-types:types/types@2.0.0.{betty-model, betty-property};

    record upload-result {
        reference: string,
        file-size: u64,
        message: option<string>,
    }

    record input {
        model: betty-model,
        property: betty-property,
        // Standard base64 (no data-URL prefix), decoded inside upload-file.
        // Not list<u8>: that costs 48 host bytes per file byte and traps at ~2.67 MiB.
        file-base64: string,
        full-filename: string,
    }

    upload: func(
        helper-context: helper-context,
        input: input,
    ) -> result<upload-result, string>;
}
